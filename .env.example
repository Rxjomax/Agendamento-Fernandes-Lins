# ==============================================================================
# VARIÁVEIS DE AMBIENTE (Configure no AI Studio -> Secrets ou Vercel -> Settings -> Environment Variables)
# Nunca commite chaves reais no GitHub.
# ==============================================================================

# 1. Assistente de Agenda com IA (Gemini)
GEMINI_API_KEY=

# 2. Envio automático de e-mails de confirmação (Resend)
# Crie sua chave em: https://resend.com/api-keys
RESEND_API_KEY=

# E-mail de destino que receberá os avisos de agendamento/compromisso.
# No plano gratuito sem domínio próprio no Resend, use o mesmo e-mail da conta Resend.
NOTIFICATION_EMAIL=marciel.fernandes@hotmail.com

# Remetente dos e-mails (no plano gratuito sem domínio próprio, mantenha onboarding@resend.dev)
RESEND_FROM=Fernandes & Lins Assessoria Jurídica <onboarding@resend.dev>

# URL pública da aplicação (opcional, preenchida automaticamente no AI Studio)
APP_URL=
